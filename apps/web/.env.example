# Required on Vercel (server only — never commit real values)
# See README.md → Security for what is safe to expose vs secret.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-key
ENCRYPTION_SECRET=32-char-minimum-secret-for-byok-encryption
GEMINI_MODEL=gemini-2.5-flash

# Optional for local Vite dev only (production loads config from GET /api/config)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

DAILY_LIMIT_PLATFORM=20
DAILY_LIMIT_BYOK=100
LATEX_COMPILE_ENABLED=true
