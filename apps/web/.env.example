# Required on Vercel (runtime — no VITE_ prefix needed)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-key
ENCRYPTION_SECRET=32-char-minimum-secret-for-byok-encryption
GEMINI_MODEL=gemini-2.0-flash

# Optional for local Vite dev only
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

DAILY_LIMIT_PLATFORM=20
DAILY_LIMIT_BYOK=100
LATEX_COMPILE_ENABLED=true
